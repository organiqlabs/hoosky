#!/usr/bin/env bash
# .git/hooks/prepare-commit-msg
# Install as .git/hooks/prepare-commit-msg.
# Drafts a commit message from the staged diff using one Gemini request.
# Never blocks a commit: any failure just falls back to the normal empty message.
set -u

COMMIT_MSG_FILE="${1:-}"
COMMIT_SOURCE="${2:-}"

MODEL="${GEMINI_MODEL:-gemini-3.5-flash-lite}"
MAX_DIFF_CHARS="${GEMINI_MAX_DIFF_CHARS:-30000}"
TIMEOUT="${GEMINI_TIMEOUT:-20}"
MAX_SUBJECT_CHARS="${GEMINI_MAX_SUBJECT_CHARS:-50}"
BODY_WRAP_CHARS="${GEMINI_BODY_WRAP_CHARS:-75}"
case "$MAX_DIFF_CHARS" in ''|*[!0-9]*) MAX_DIFF_CHARS=30000 ;; esac
[ "${#MAX_DIFF_CHARS}" -gt 15 ] && MAX_DIFF_CHARS=30000
MAX_DIFF_CHARS=$((10#$MAX_DIFF_CHARS))
[ "$MAX_DIFF_CHARS" -le 0 ] && MAX_DIFF_CHARS=30000
case "$TIMEOUT" in ''|*[!0-9]*) TIMEOUT=20 ;; esac
[ "${#TIMEOUT}" -gt 2 ] && TIMEOUT=20
TIMEOUT=$((10#$TIMEOUT))
[ "$TIMEOUT" -le 0 ] && TIMEOUT=20
case "$MAX_SUBJECT_CHARS" in ''|*[!0-9]*) MAX_SUBJECT_CHARS=50 ;; esac
[ "${#MAX_SUBJECT_CHARS}" -gt 3 ] && MAX_SUBJECT_CHARS=50
MAX_SUBJECT_CHARS=$((10#$MAX_SUBJECT_CHARS))
[ "$MAX_SUBJECT_CHARS" -le 0 ] && MAX_SUBJECT_CHARS=50
case "$BODY_WRAP_CHARS" in ''|*[!0-9]*) BODY_WRAP_CHARS=75 ;; esac
[ "${#BODY_WRAP_CHARS}" -gt 3 ] && BODY_WRAP_CHARS=75
BODY_WRAP_CHARS=$((10#$BODY_WRAP_CHARS))
[ "$BODY_WRAP_CHARS" -le 0 ] && BODY_WRAP_CHARS=75

warn() { printf 'ai-commit: %s\n' "$*" >&2; }
DETAIL="${GEMINI_DETAIL_LEVEL:-minimal}"
case "$DETAIL" in
  [Mm][Ii][Nn][Ii][Mm][Aa][Ll]) DETAIL=minimal ;;
  [Ss][Tt][Aa][Nn][Dd][Aa][Rr][Dd]) DETAIL=standard ;;
  [Dd][Ee][Tt][Aa][Ii][Ll][Ee][Dd]) DETAIL=detailed ;;
  *) warn "GEMINI_DETAIL_LEVEL '$DETAIL' is not one of minimal|standard|detailed; using minimal"; DETAIL=minimal ;;
esac
case "$DETAIL" in
  minimal)  DETAIL_TEXT='Minimal:  Subject line + single paragraph of technical reasoning.' ;;
  standard) DETAIL_TEXT='Standard: Multi-paragraph technical justification: problem and solution.' ;;
  detailed) DETAIL_TEXT='Detailed: Exhaustive docs: before/after state, logic flow, architectural implications.' ;;
esac
case "$MODEL" in ''|*[!A-Za-z0-9._-]*) warn "GEMINI_MODEL '$MODEL' is not a valid model id; using 'gemini-3.5-flash-lite'"; MODEL="gemini-3.5-flash-lite" ;; esac
API_URL="https://generativelanguage.googleapis.com/v1beta/models/${MODEL}:generateContent"

# Greedily re-wrap stdin to <width> columns; blank lines delimit paragraphs.
# A word longer than <width> sits on its own line (never split).
wrap_text() {
  local width="$1" line w cur=""
  local -a words=()
  while IFS= read -r line; do
    if [[ "$line" =~ ^[[:space:]]*$ ]]; then
      if [ -n "$cur" ]; then printf '%s\n' "$cur"; cur=""; fi
      printf '\n'
      continue
    fi
    IFS=' ' read -ra words <<< "$line"
    for w in "${words[@]}"; do
      if [ -z "$cur" ]; then
        cur="$w"
      elif [ $(( ${#cur} + 1 + ${#w} )) -le "$width" ]; then
        cur="$cur $w"
      else
        printf '%s\n' "$cur"
        cur="$w"
      fi
    done
  done
  if [ -n "$cur" ]; then printf '%s\n' "$cur"; fi
}

# --- Guards
[ -n "$COMMIT_MSG_FILE" ] || exit 0
[ "${SKIP_AI_COMMIT:-0}" = "1" ] && exit 0
case "$COMMIT_SOURCE" in message|merge|squash|commit) exit 0 ;; esac  # -m, merge, squash, amend/-c/-C
[ -r "$COMMIT_MSG_FILE" ] && [ -f "$COMMIT_MSG_FILE" ] || { warn "message file '$COMMIT_MSG_FILE' not readable (missing, not a regular file, or no permission); skipping"; exit 0; }

for cmd in curl jq git grep sed tr; do
  command -v "$cmd" >/dev/null 2>&1 || { warn "'$cmd' not found; skipping"; exit 0; }
done

grep -qE '^[^#[:space:]]' "$COMMIT_MSG_FILE"; grc=$?              # message already has content?
if [ "$grc" -eq 0 ]; then exit 0; fi
if [ "$grc" -ge 2 ]; then warn "could not inspect message file '$COMMIT_MSG_FILE'; skipping"; exit 0; fi
[ -w "$(dirname "$COMMIT_MSG_FILE")" ] || { warn "directory '$(dirname "$COMMIT_MSG_FILE")' is not writable; skipping"; exit 0; }

[ -n "${GEMINI_API_KEY:-}" ] || { warn "GEMINI_API_KEY not set; skipping"; exit 0; }
case "$GEMINI_API_KEY" in
  *\"*|*\\*|*$'\r'*|*$'\n'*) warn "GEMINI_API_KEY contains characters unsafe for curl config; skipping"; exit 0 ;;
esac

# --- Collect context
TMP="$(mktemp -d)" || { warn "mktemp -d failed; skipping"; exit 0; }
SIBLING=""
trap 'rm -rf "$TMP"; [ -z "$SIBLING" ] || rm -f "$SIBLING"' EXIT
trap 'exit 130' INT
trap 'exit 143' TERM
# All patterns are `*`-prefixed so they match at any depth (root included) under git's
# default pathspec magic; case-insensitive everywhere. Do not drop the leading `*`.
EXCLUDES=(':(exclude,icase)*.env' ':(exclude,icase)*.env.*' ':(exclude,icase)*.envrc*' ':(exclude,icase)*.npmrc' ':(exclude,icase)*.pypirc' ':(exclude,icase)*.netrc'
          ':(exclude,icase)*.git-credentials' ':(exclude,icase)*credentials*.json'
          ':(exclude,icase)*secrets.*'
          ':(exclude,icase)*id_rsa*' ':(exclude,icase)*id_dsa*' ':(exclude,icase)*id_ecdsa*' ':(exclude,icase)*id_ed25519*'
          ':(exclude,icase)*.pgpass' ':(exclude,icase)*.htpasswd'
          ':(exclude,icase)*.docker/config.json' ':(exclude,icase)*.kube/config'
          ':(exclude,icase)*.aws/credentials' ':(exclude,icase)*.m2/settings.xml' ':(exclude,icase)*.ppk'
          ':(exclude,icase)*.p12' ':(exclude,icase)*.pfx' ':(exclude,icase)*.jks' ':(exclude,icase)*.keystore'
          ':(exclude,icase)*.pem' ':(exclude,icase)*.key'
          ':(exclude,icase)*.tfstate*' ':(exclude,icase)*.vault-token' ':(exclude,icase)*.vault_pass'
          ':(exclude,icase)*vault-password*' ':(exclude,icase)*vault_password*' ':(exclude,icase)*.keytab'
          ':(exclude,icase)*.p8' ':(exclude,icase)*.dockercfg' ':(exclude,icase)*.yarnrc*'
          ':(exclude,icase)*_netrc' ':(exclude,icase)*.asc' ':(exclude,icase)*.gpg'
          ':(exclude,icase)*.cargo/credentials*' ':(exclude,icase)*.gem/credentials'
          ':(exclude,icase)*.lock' ':(exclude,icase)*package-lock.json' ':(exclude,icase)*npm-shrinkwrap.json'
          ':(exclude,icase)*pnpm-lock.yaml' ':(exclude,icase)*bun.lockb'
          ':(exclude,icase)*.min.js' ':(exclude,icase)*.min.css' ':(exclude,icase)*.map')

FULL_DIFF="$(git diff --no-ext-diff --no-textconv --cached --no-color --unified=2 -- . "${EXCLUDES[@]}" 2>/dev/null)"
[ -n "$FULL_DIFF" ] || exit 0

NOTE=""
DIFF="$FULL_DIFF"
if [ "${#FULL_DIFF}" -gt "$MAX_DIFF_CHARS" ]; then
  CUT="${FULL_DIFF:0:$MAX_DIFF_CHARS}"
  TRIMMED="${CUT%"${CUT##*$'\n'}"}"   # keep only complete lines
  if [ -n "$TRIMMED" ]; then
    DIFF="$TRIMMED"
    NOTE="(Diff truncated to the first ${MAX_DIFF_CHARS} characters; cut at a line boundary.)"
  else
    DIFF="$CUT"                       # no newline in cut: keep raw slice
    NOTE="(Diff truncated to the first ${MAX_DIFF_CHARS} characters; no line boundary in the cut.)"
  fi
fi
case "$DIFF" in *$'\n') ;; *) DIFF="$DIFF"$'\n' ;; esac

# cap at 4000 bytes, and only drop the (possibly partial) first line when we know a cut happened;
# slice bytes from a temp file so trailing newlines don't shift the window arithmetic;
# a single >4000-byte line with no newline would make the tail-line drop empty, so fall back to the raw slice
# stat capture is an unguarded tool: on failure stat.txt stays empty and STAT degrades to empty
# (an accepted, non-blocking fallback, consistent with the unguarded-tool policy in AGENTS.md).
git diff --no-ext-diff --no-textconv --cached --stat --no-color -- . "${EXCLUDES[@]}" > "$TMP/stat.txt" 2>/dev/null
stat_bytes="$(wc -c < "$TMP/stat.txt")"
case "$stat_bytes" in ''|*[!0-9]*) stat_bytes=0 ;; esac   # wc failed → treat as small, keep whole stat
if [ "$stat_bytes" -gt 4000 ]; then
  before="$(head -c $((stat_bytes-4000)) "$TMP/stat.txt" | tail -c 1 | od -An -tx1 | tr -d ' \n')"
  if [ "$before" = '0a' ]; then
    STAT="$(tail -c 4000 "$TMP/stat.txt")"        # cut lands on a line boundary: first line complete
  else
    STAT="$(tail -c 4000 "$TMP/stat.txt" | tail -n +2)"   # partial first line dropped
    [ -z "$STAT" ] && STAT="$(tail -c 4000 "$TMP/stat.txt")"
  fi
  STAT="(Diff stat truncated to the last 4000 bytes.)
$STAT"
else
  STAT="$(cat "$TMP/stat.txt")"
fi
BRANCH="$(git branch --show-current 2>/dev/null)"
RECENT="$(git log -5 --pretty=format:'%s' 2>/dev/null || true)"

# --- Build request
# AUDIT WARNING: the heredoc below is UNQUOTED by design — ${BRANCH}, ${RECENT},
# ${STAT}, ${DIFF}, ${NOTE}, and the knob expansions are spliced in here. That means
# the static text must contain NOTHING the shell would expand or substitute:
# no bare $, no backticks, no \r. If you add static prompt text, keep it shell-clean.
cat > "$TMP/prompt.txt" <<EOF
A commit message is permanent technical documentation. Explain *why* a change is necessary with precision.

Respond in plain text only. Do NOT use markdown, code fences, backticks, or any formatting. Output ONLY the commit message itself — no preamble, no explanation, no commentary before or after.

Structure the message as a subject line with an imperative verb (max ${MAX_SUBJECT_CHARS} characters), then a blank line, then the body (wrapped at ${BODY_WRAP_CHARS} columns).

Use Conventional Commits: type(scope): summary (feat, fix, docs, style, refactor, perf, test, build, ci, chore). Never end the subject with a period. Name only files, symbols, and issue numbers that appear in the diff below.

Required detail level (${DETAIL}): ${DETAIL_TEXT}

Branch: ${BRANCH}
Recent commit subjects (match their style where sensible):
${RECENT}

Diff stat:
${STAT}

Staged diff:
${DIFF}
${NOTE}
EOF

jq -n --rawfile p "$TMP/prompt.txt" '{contents:[{parts:[{text:$p}]}]}' > "$TMP/body.json" || { warn "could not build request payload; skipping"; exit 0; }

# --- Call Gemini (key goes via stdin config so it never shows up in `ps`) --
# --max-filesize caps the response; on exceed curl fails and the hook no-ops.
RESPONSE="$(printf 'header = "x-goog-api-key: %s"\n' "$GEMINI_API_KEY" |
  curl -sS --max-time "$TIMEOUT" --max-filesize 10485760 -K - \
    -H 'Content-Type: application/json' \
    -d @"$TMP/body.json" "$API_URL" 2>"$TMP/curl.err")"

MSG="$(printf '%s' "$RESPONSE" |
  jq -r '[.candidates[0].content.parts[]? | .text // empty] | join("")' 2>/dev/null)"

if [ -z "$MSG" ]; then
  ERR="$(printf '%s' "$RESPONSE" | jq -r '.error.message // empty' 2>/dev/null)"
  [ -n "$ERR" ] || ERR="$(cat "$TMP/curl.err" 2>/dev/null)"
  ERR="$(printf '%s' "$ERR" | tr -d '\000-\010\013-\037\177' | head -c 200)"
  warn "no message generated${ERR:+: $ERR}"
  exit 0
fi

# Strip stray code fences and leading blank lines; C0/DEL controls can be smuggled
# via a hostile model response (echoing attacker-controlled diff content) and fire
# as terminal escapes when the committer reads the log;
# tabs are expanded so the wrap width counts visible columns consistently.
MSG="$(printf '%s' "$MSG" | tr -d '\000-\010\013-\037\177' | tr '\t' ' ' | sed -E -e '/^[[:space:]]*[`~]{3,}([A-Za-z0-9_.+#-]+)?[[:space:]]*$/d' -e '/[^[:space:]]/,$!d')"
[ -n "$MSG" ] || { warn "response contained only formatting noise; skipping"; exit 0; }

# --- Normalize the final format: subject limit + body wrap (configurable)
SUBJ="${MSG%%$'\n'*}"
REM="${MSG#"$SUBJ"}"
BODY="${REM#$'\n'}"
BODY="$(printf '%s' "$BODY" | sed -e '/[^[:space:]]/,$!d')"   # collapse leading blank lines
if [ "${#SUBJ}" -gt "$MAX_SUBJECT_CHARS" ]; then
  CUT="${SUBJ:0:$MAX_SUBJECT_CHARS}"
  TRIMMED="${CUT% *}"             # cut back to the last word boundary
  [ -z "$TRIMMED" ] && TRIMMED="$CUT"
  warn "subject exceeds ${MAX_SUBJECT_CHARS} chars; truncated"
  SUBJ="$TRIMMED"
fi
if [ -n "$BODY" ]; then
  WRAPPED="$(printf '%s\n' "$BODY" | wrap_text "$BODY_WRAP_CHARS")"
  MSG="$SUBJ"$'\n\n'"$WRAPPED"
else
  MSG="$SUBJ"
fi

# --- Prepend draft; atomic-ish write into the same directory as the msg file
# mktemp template in the msg dir (same filesystem for mv; unpredictable name, no clobber)
SIBLING="$(mktemp "${COMMIT_MSG_FILE}.ai-commit.XXXXXX" 2>/dev/null)" || { warn "could not create temp sibling for '$COMMIT_MSG_FILE'; skipping"; exit 0; }
chmod 0644 "$SIBLING" || { warn "could not chmod sibling temp file '$SIBLING'; skipping"; exit 0; }
if { printf '%s\n\n' "$MSG"; cat "$COMMIT_MSG_FILE"; } > "$SIBLING" 2>/dev/null &&
  mv -f "$SIBLING" "$COMMIT_MSG_FILE"; then
  SIBLING=""
  exit 0
fi
warn "could not write message file; leaving it unchanged"   # the EXIT trap removes $SIBLING
exit 0

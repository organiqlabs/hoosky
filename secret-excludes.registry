# Single source of truth for the staged-diff secret/credential deny-list.
#
# Edit this file, then run `make generate-excludes`. Never hand-edit a generated
# block: the generator rewrites the EXCLUDES array in prepare-commit-msg, the
# deny-list prose in README.md and AGENTS.md, and the sentinel matrix in
# prepare-commit-msg.test.sh. `make test` runs the generator in --check mode so
# a stale generated block fails the gate.
#
# The hook is published as a single self-contained bash file (curl | bash install),
# so the patterns are generated *into* it at development time; there is no runtime
# dependency on this registry.

[CATEGORIES]
env|Environment files
keys|Private keys and certificates
credentials|Credential and config files
tf|Terraform material
vault|Vault material
kerberos|Kerberos material
apple|Apple keys
yarnrc|Yarnrc auth
locks|Lockfiles
minified|Minified assets

[PATTERNS]
# glob|category — the generator prepends :(exclude,icase) to each glob.
*.env|env
*.env.*|env
*.envrc*|env
*.npmrc|credentials
*.pypirc|credentials
*.netrc|credentials
*.git-credentials|credentials
*credentials*.json|credentials
*secrets.*|credentials
*id_rsa*|keys
*id_dsa*|keys
*id_ecdsa*|keys
*id_ed25519*|keys
*.pgpass|credentials
*.htpasswd|credentials
*.docker/config.json|credentials
*.kube/config|credentials
*.aws/credentials|credentials
*.m2/settings.xml|credentials
*.ppk|keys
*.p12|keys
*.pfx|keys
*.jks|keys
*.keystore|keys
*.pem|keys
*.key|keys
*.tfstate*|tf
*.vault-token|vault
*.vault_pass|vault
*vault-password*|vault
*vault_password*|vault
*.keytab|kerberos
*.p8|apple
*.dockercfg|credentials
*.yarnrc*|yarnrc
*_netrc|credentials
*.asc|keys
*.gpg|keys
*.cargo/credentials*|credentials
*.gem/credentials|credentials
*.lock|locks
*package-lock.json|locks
*npm-shrinkwrap.json|locks
*pnpm-lock.yaml|locks
*bun.lockb|locks
*.min.js|minified
*.min.css|minified
*.map|minified

[SENTINELS]
# path|sentinel — representative cases proving each pattern (and its case/nesting
# variants) is excluded. Keep every pattern covered here when adding a new one.
secret.pem|SEN-PEM-1
infra/prod.tfstate|SEN-TFSTATE-1
sub/prod.tfstate.backup|SEN-TFSBAK-1
sub/.vault-token|SEN-VAULTTOK-1
config/.vault_pass|SEN-VAULTPASS-1
sub/deep/key.keytab|SEN-KEYTAB-1
keys/AuthKey.p8|SEN-P8-1
sub/.dockercfg|SEN-DOCKERCFG-1
sub/.yarnrc|SEN-YARNRC-1
sub/_netrc|SEN-NETRCW-1
keys/backup.asc|SEN-ASC-1
